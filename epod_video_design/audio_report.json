    "sampleRate": 48000,
    "bitrate": 192000,
    "channels": 1,
    "codec": "MPEG 1 Layer 3"
  },
  {
    "scene": "S04",
    "text": "This is the coin cell. The flat side with the writing is the positive side, marked plus.",
    "audioDuration": 7.2,
    "startSec": 0.5,
    "audioEnd": 7.7,
    "durationSec": 7,
    "slack": -0.7000000000000002,
    "fits": false,
