    "bitrate": 192000,
    "channels": 1,
    "codec": "MPEG 1 Layer 3"
  },
  {
    "scene": "S07",
    "text": "Keep the positive side facing up. Lower the battery into the holder and press gently.",
    "audioDuration": 7.152,
    "startSec": 0.4,
    "audioEnd": 7.5520000000000005,
    "durationSec": 7,
    "slack": -0.5520000000000005,
