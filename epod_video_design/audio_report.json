[
  {
    "scene": "S01",
    "text": "Let's learn how to insert the battery into the Battery ePod.",
    "audioDuration": 4.968,
    "startSec": 0.4,
    "audioEnd": 5.368,
    "durationSec": 6,
    "slack": 0.6319999999999997,
