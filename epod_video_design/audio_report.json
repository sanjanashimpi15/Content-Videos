    "codec": "MPEG 1 Layer 3"
  },
  {
    "scene": "S02",
    "text": "You need two things: the Battery ePod, and a CR2032 coin cell, a three-volt lithium battery.",
    "audioDuration": 9.264,
    "startSec": 0.5,
    "audioEnd": 9.764,
    "durationSec": 9,
