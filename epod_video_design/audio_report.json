    "sampleRate": 48000,
    "bitrate": 192000,
    "channels": 1,
    "codec": "MPEG 1 Layer 3"
  },
  {
    "scene": "S05",
    "text": "Pick up the ePod and hold it flat, with the battery holder facing up.",
    "audioDuration": 5.736,
    "startSec": 0.4,
    "audioEnd": 6.136,
    "durationSec": 6,
    "slack": -0.13600000000000012,
    "fits": false,
    "fileSize": 138284,
    "sampleRate": 48000,
    "bitrate": 192000,
    "channels": 1,
    "codec": "MPEG 1 Layer 3"
  },
  {
    "scene": "S06",
    "text": "Take the battery in your other hand and bring it to the holder.",
    "audioDuration": 4.92,
    "startSec": 0.4,
    "audioEnd": 5.32,
    "durationSec": 6,
    "slack": 0.6799999999999997,
    "fits": true,
