    "sampleRate": 48000,
    "bitrate": 192000,
    "channels": 1,
    "codec": "MPEG 1 Layer 3"
  },
  {
    "scene": "S03",
    "text": "The ePod has a round battery holder in the middle, with a connector on each side.",
    "audioDuration": 6.576,
    "startSec": 0.5,
    "audioEnd": 7.076,
    "durationSec": 7,
    "slack": -0.07599999999999962,
    "fits": false,
