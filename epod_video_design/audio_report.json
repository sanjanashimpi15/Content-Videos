    "bitrate": 192000,
    "channels": 1,
    "codec": "MPEG 1 Layer 3"
  },
  {
    "scene": "S08",
    "text": "Press until the battery sits flat and level in the holder. It should not wobble.",
    "audioDuration": 6.792,
    "startSec": 0.4,
    "audioEnd": 7.192,
    "durationSec": 8,
    "slack": 0.8079999999999998,
